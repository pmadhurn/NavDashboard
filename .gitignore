# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Environment
# There was a `!.env.example` negation here with nothing ever ignoring `.env`
# itself, so every .env was committable — which is how backend/.env got tracked
# with a live SECRET_KEY, and how a Cloudflare tunnel token ended up in history.
.env
.env.*
!.env.example
backend/.env

# Local-only compose overrides (hardcode host-specific ports)
docker-compose.override.yml

# Docker
postgres_data/
redis_data/

# Database
database/backups/*.sql
database/backups/*.dump

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

#venv

venv
temperate
frontend/.env
