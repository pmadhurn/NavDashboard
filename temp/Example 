const CustomTooltip = ({ active, payload, label }) => {
  if (!active || !payload?.length) return null
  return (
    <div style={{
      background: 'rgba(20, 20, 20, 0.9)',
      backdropFilter: 'blur(10px)',
      border: '1px solid rgba(255, 255, 255, 0.08)',
      borderRadius: 8,
      padding: '8px 12px',
      color: '#F2F2F2',
      fontSize: 13,
    }}>
      <p>{label}: {payload[0].value}</p>
    </div>
  )
}
