
# --- Clerk (identity only; roles/permissions stay in this app) ---
# Leave blank to keep the Clerk button hidden and /auth/clerk disabled.
VITE_CLERK_PUBLISHABLE_KEY=

# --- PostHog (off unless a key is set; no script is loaded when blank) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Autocapture records every click/input. Off by default — this app's DOM has
# device serials, personnel names and expense amounts in it.
VITE_POSTHOG_AUTOCAPTURE=false
