**Repository pattern:**
```python
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func, or_, and_, desc
from uuid import UUID
from typing import Optional

async def get_by_id(db: AsyncSession, id: UUID) -> Optional[Model]:
    result = await db.execute(select(Model).where(Model.id == id, Model.deleted_at.is_(None)))
    return result.scalar_one_or_none()

async def get_multi(db: AsyncSession, skip: int = 0, limit: int = 100, filters: dict | None = None) -> list[Model]:
    query = select(Model).where(Model.deleted_at.is_(None))
    query = query.offset(skip).limit(limit)
    result = await db.execute(query)
    return list(result.scalars().all())
```

